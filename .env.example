# "hashing" is an offline demo embedding. For better retrieval use a real embedding model.
EMBEDDINGS_PROVIDER=hashing
# EMBEDDINGS_PROVIDER=openai
# EMBEDDINGS_MODEL=<embedding model name>

# "stub" returns the best matching sentences from the retrieved text (no language model).
LLM_PROVIDER=stub
# LLM_PROVIDER=openai
# LLM_MODEL=<model name>
# OPENAI_API_KEY=...

CHUNK_SIZE=500
CHUNK_OVERLAP=80
TOP_K=3
MIN_SIMILARITY=0.12
